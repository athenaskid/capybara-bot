{
  "name": "capybara-bot",
  "version": "1.3.0",
  "main": "index.ts",
  "repository": "git@github.com:athenaskid/capybara-bot.git",
  "author": "athenaskid <me@annievo.us>",
  "license": "MIT",
  "scripts": {
    "dev": "STAGING=true ts-node -r tsconfig-paths/register src/index.ts",
    "register": "REGISTER=true STAGING=true ts-node -r tsconfig-paths/register -T src/index.ts",
    "start": "ts-node -r tsconfig-paths/register -T src/index.ts",
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    }
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "discord.js": "^14.27.0",
    "moment-timezone": "^0.6.5",
    "mongoose": "^9.11.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "dotenv": "^18.0.6",
    "jest": "^30.5.2",
    "node-cron": "^4.6.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
